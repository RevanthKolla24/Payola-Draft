# Copy to .env for local use; npm start does not automatically load it.
# Run locally with: node --env-file=.env server.js
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Optional: set through your hosting dashboard in production, never commit keys.
LASTFM_API_KEY=
# Keep the experimental preview disabled until live authorization is verified.
ENABLE_APPLE_PREVIEW=false
APPLE_MUSIC_DEVELOPER_TOKEN=

# Real shared Job Tracker/Payola web configuration is built in (public, not secret).
# Set false only to deliberately disable accounts. Remove stale false on Render.
ENABLE_FIREBASE_ACCOUNTS=true
# Normally leave all four overrides UNSET. To use a different project, provide
# ALL four: FIREBASE_PROJECT_ID, FIREBASE_AUTH_DOMAIN, FIREBASE_API_KEY,
# FIREBASE_APP_ID. Blank/partial overrides disable accounts rather than mix apps.
# Never set a service-account key or Admin SDK credential here.
