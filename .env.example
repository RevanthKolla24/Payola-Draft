# Copy to .env for local use; npm start does not automatically load it.
# Run locally with: node --env-file=.env server.js
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Optional: set through your hosting dashboard in production, never commit keys.
LASTFM_API_KEY=
# Keep the experimental preview disabled until live authorization is verified.
ENABLE_APPLE_PREVIEW=false
APPLE_MUSIC_DEVELOPER_TOKEN=
